+( n=0
+  while [ ! -f "$B/voltset.sh" ] && [ $n -lt 360 ]; do sleep 5; n=$((n+1)); done
+  if [ ! -f "$B/voltset.sh" ]; then echo "$(date '+%F %T') bundle unreachable: $B" >> "$L"; exit 1; fi
